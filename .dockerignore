# Зависимости (не в образ)
node_modules
**/node_modules

# Артефакты сборки
dist
**/dist
*.tsbuildinfo

# Данные рантайма (гигабайты чанков/записей — НЕ в контекст)
data
data/**
ffmpeg-manager/recordings/**

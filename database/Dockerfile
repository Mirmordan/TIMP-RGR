# ============================================================
# Dockerfile для инициализации БД (PostgreSQL).
#
# Использует официальный образ postgres: файлы из
# /docker-entrypoint-initdb.d исполняются при первом старте
# (по алфавиту), создавая схему и политики RLS.
#
# В проде этот контейнер не "всегда живой" — он инициализирует
# данные, а саму БД держит сервис postgres из docker-compose.
# ============================================================

FROM postgres:16-alpine

# Кладём SQL-скрипты инициализации в точку автозапуска образа
COPY ./setup /docker-entrypoint-initdb.d

# Образ postgres сам выполняет файлы при создании нового кластера.
# Никаких CMD/ENTRYPOINT переопределять не нужно — используется
# штатный entrypoint постгреса.

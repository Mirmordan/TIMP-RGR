PORT=5000
APP_ADDRESS=localhost
API_PREFIX=/api/v1
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=timprgr
DB_USER=timprgr_app
DB_PASSWORD=timprgr_app_password

# --- Security ---
JWT_SECRET=dev-secret-сменить-в-проде
JWT_REFRESH_SECRET=dev-refresh-secret-сменить-в-проде
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Media Manager (mediaMTX Control API) ---
# Бэкенд создаёт/удаляет пути (потоки) и управляет записью.
MEDIA_MTX_API=http://localhost:9997
# Корень записи чанков внутри контейнера mediaMTX (для recordPath в mediaMTX API).
MEDIA_MTX_RECORD_ROOT=/data/chunks
# Корень записи на хосте (для сканирования сегментов бэкендом).
MEDIA_RECORD_ROOT_HOST=/home/mirmordan/Projects/TIMP-RGR/data/chunks

# --- Защищённый owner-аккаунт (обычный admin, username === OWNER_USERNAME) ---
# Пусто OWNER_USERNAME → owner не инициализируется (в лог пишется warn).
# OWNER_USERNAME=owner
# OWNER_PASSWORD=сменить-на-длинный-пароль
# OWNER_EMAIL=owner@example.com
# OWNER_PASSWORD_FORCE=0
